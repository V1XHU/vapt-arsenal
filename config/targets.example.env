# Copy this file to targets.env and fill it in.
# targets.env is gitignored, so your real scope is never committed.

# Root domain for subdomain enumeration (no scheme).
TARGET_DOMAIN=example.com

# Base URL of the specific app under test (with scheme).
BASE_URL=https://example.com

# Content-discovery wordlist (adjust to your SecLists path).
WORDLIST=/usr/share/seclists/Discovery/Web-Content/directory-list-2.3-medium.txt

# Where results are written (gitignored).
OUT_DIR=./out

# Extra header sent with requests, e.g. an auth token for API testing.
# Leave blank for unauthenticated scans.
AUTH_HEADER=
# Example: AUTH_HEADER=Authorization: Bearer <your-token-here>
